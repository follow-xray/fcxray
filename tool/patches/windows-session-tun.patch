+func checkFcxrayUplink(route4, route6 bool) error {
+	if updater == nil {
+		return nil
+	}
+	iface := updater.Get()
+	if iface == nil {
+		return errors.New("no usable outbound interface")
+	}
+	luid, err := winipcfg.LUIDFromIndex(uint32(iface.Index))
+	if err != nil {
+		return err
+	}
+	for _, family := range []winipcfg.AddressFamily{windows.AF_INET, windows.AF_INET6} {
+		if (family == windows.AF_INET && !route4) || (family == windows.AF_INET6 && !route6) {
+			continue
+		}
+		row, err := luid.IPInterface(family)
+		if err == nil && (row.WeakHostSend || row.ForwardingEnabled) {
+			return errors.New("TUN requires strong host send without forwarding on ", iface.Name, "; physical network settings were preserved")
+		}
+	}
+	return nil
 }
 
